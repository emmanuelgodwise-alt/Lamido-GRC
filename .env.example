# ============================================================
# Lamido, Lamido & Co. — environment variables
# ============================================================
# Copy this file to `.env.local` for local development.
# NEVER commit real values. Only browser-safe (NEXT_PUBLIC_*)
# variables belong in the frontend — secrets never do.

# Canonical public site URL, without a trailing slash.
# Used for metadata, Open Graph, and canonical URLs.
# Optional: on Vercel the deployment URL is detected automatically
# (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL); unset means local dev.
# TODO(owner): replace with the production domain once confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase — required from Stage 3 onward. Leave blank for now.
# ------------------------------------------------------------
# Public, browser-safe values ONLY. The service-role key must be
# configured as a Supabase Edge Function secret, never in this file
# and never in frontend code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
